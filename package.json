{
  "name": "lunarshield",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-ready Manifest V3 theme engine: universal dark mode, night shift, OLED mode, per-site rules, schedules, smart image protection and on-device site detection.",
  "license": "MIT",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "dev": "pnpm icons && vite",
    "build": "pnpm icons && pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
